NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local development defaults to SQLite. Render injects DATABASE_URL for PostgreSQL.
DB_URL=sqlite:./data/eduplateforme.sqlite
# DATABASE_URL=postgresql://user:password@localhost:5432/eduplateforme

# Required in production; use independent random values of at least 32 characters.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
BCRYPT_ROUNDS=10
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
